  "code": "def ingest_basilisk_advisories(\n    vulnerability_basilisk_raw,\n    core_packages_enumerated: pd.DataFrame,\n) -> pd.DataFrame:\n    # legacy: Basilisk /v1/querybatch  (FR-19, Story B8; spec §13.1)\n    \"\"\"Flatten the ``POST /v1/querybatch`` batch payload into the lightweight ``basilisk_vulns``\n    shape (``conda_name``, ``advisory_id``, ``modified``) — **matched BY PACKAGE NAME** (AC-2).\n\n    ``vulnerability_basilisk_raw`` is what ``BasiliskBatchDataset`` resolves: a list of per-query\n    records ``{\"conda_name\", \"advisories\": [{\"id\", \"modified\", \"affected\": [{\"ecosystem\"}...]}]}``\n    (offline -> ``[]`` + a staleness marker on the dataset). Each advisory is attributed to the\n    **queried conda_name** (the conda-PURL query key) — the code NEVER filters on\n    ``affected[].ecosystem`` (THE FR-19 CRUX: an advisory whose ``affected[]`` ecosystem reads\n    ``PyPI`` STILL matches its conda package). ``core_packages_enumerated`` (``conda_name`` /\n    ``latest_version``, B1/Phase B) is the population; when present it restricts the output to\n    known conda packages (graceful: empty/absent -> no restriction). Pure — no IO.\n\n    Output ``vulnerability_basilisk_advisories`` (the AD-14 new-signal PRIMARY, EXCLUDED from B4\n    parity): ``conda_name``, ``advisory_id``, ``modified``.\n    \"\"\"\n    cols = [\"conda_name\", \"advisory_id\", \"modified\"]\n    records = vulnerability_basilisk_raw if isinstance(vulnerability_basilisk_raw, list) else []\n\n    population: set[str] = set()\n    pop = core_packages_enumerated\n    if pop is not None and not getattr(pop, \"empty\", True) and \"conda_name\" in pop.columns:\n        population = {str(n) for n in pop[\"conda_name\"].dropna()}\n\n    rows: list[dict[str, Any]] = []\n    for rec in records:\n        if not isinstance(rec, dict):\n            continue\n        conda_name = rec.get(\"conda_name\")\n        if conda_name is None:\n            continue\n        conda_name = str(conda_name)\n        # Match BY NAME: restrict to the known conda population when we have one; NEVER\n        # filter on the OSV ecosystem tag (that is the FR-19 gotcha this node exists to avoid).\n        if population and conda_name not in population:\n            continue\n        advs = rec.get(\"advisories\")\n        if not isinstance(advs, list):  # a single dict / None / malformed -> skip, never crash\n            continue\n        for adv in advs:\n            if not isinstance(adv, dict):\n                continue\n            advisory_id = adv.get(\"id\")\n            if advisory_id is None:\n                continue\n            rows.append(\n                {\n                    \"conda_name\": conda_name,\n                    \"advisory_id\": str(advisory_id),\n                    \"modified\": adv.get(\"modified\"),\n                }\n            )\n    if not rows:\n        return pd.DataFrame(columns=cols)\n    return pd.DataFrame(rows, columns=cols).drop_duplicates(\n        subset=[\"conda_name\", \"advisory_id\"], keep=\"last\"\n    ).reset_index(drop=True)\n",
