{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-recipes:governance:ci-surfaces.schema",
  "title": "CI surfaces registry",
  "type": "object",
  "required": [
    "version",
    "conventions",
    "grandfathered_names",
    "surfaces"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "conventions": {
      "type": "object",
      "required": [
        "pause_prefix",
        "enable_prefix",
        "master",
        "dispatch_ignores_pauses"
      ],
      "additionalProperties": false,
      "properties": {
        "pause_prefix": {
          "type": "string",
          "minLength": 1
        },
        "enable_prefix": {
          "type": "string",
          "minLength": 1
        },
        "master": {
          "type": "string",
          "minLength": 1
        },
        "dispatch_ignores_pauses": {
          "type": "boolean"
        }
      }
    },
    "grandfathered_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": [
        "id",
        "workflow",
        "kind",
        "cost",
        "gate",
        "switch_class",
        "state",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "workflow",
            "ci-job",
            "ci-step",
            "scheduled",
            "local-stage",
            "value"
          ]
        },
        "job": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "cost": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "gate": {
          "type": "boolean"
        },
        "switch": {
          "type": [
            "string",
            "null"
          ]
        },
        "switch_class": {
          "type": "string",
          "enum": [
            "pause",
            "enable",
            "value"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "live",
            "paused",
            "opt-in-off",
            "paused-manually",
            "retired"
          ]
        },
        "paused_since": {
          "type": "string"
        },
        "paused_by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "review_by": {
          "type": "string"
        },
        "local_twin": {
          "type": "string"
        },
        "canary": {
          "type": "string"
        },
        "transitive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stuck_rules": {
          "type": "object"
        },
        "dispatch": {
          "type": "string",
          "enum": [
            "bypass",
            "pause-only"
          ]
        },
        "retired_on": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "enum": [
            "main"
          ],
          "description": "`main`: the surface never runs on a pull_request -- it runs on push-to-main and the nightly canary builds it (Stories 117.6 / 117.8, CAP-175 ruling D1). Absent means it follows its workflow's triggers."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ci-job"
              }
            }
          },
          "then": {
            "required": [
              "job"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ci-step"
              }
            }
          },
          "then": {
            "required": [
              "job",
              "step"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "paused"
              }
            }
          },
          "then": {
            "required": [
              "paused_since",
              "paused_by",
              "reason",
              "review_by"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "paused-manually"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
