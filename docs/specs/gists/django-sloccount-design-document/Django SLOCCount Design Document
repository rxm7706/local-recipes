### 3. COCOMO Estimator (`sloccount/core/cocomo.py`)

```python
"""COCOMO (Constructive Cost Model) for effort and cost estimation."""

from dataclasses import dataclass
from enum import Enum
from typing import Optional


class ProjectMode(Enum):
    """COCOMO project modes."""
    ORGANIC = "organic"
    SEMIDETACHED = "semidetached"
    EMBEDDED = "embedded"


@dataclass
class COCOMOParams:
    """COCOMO model parameters."""
    # Effort: person-months = factor * (KSLOC ^ exponent)
    effort_factor: float
    effort_exponent: float
    
    # Schedule: months = factor * (person-months ^ exponent)
    schedule_factor: float
    schedule_exponent: float


@dataclass
class CostParams:
    """Cost estimation parameters."""
    annual_salary: float = 56286.0    # Original 2000 value
    overhead_multiplier: float = 2.4   # Benefits, facilities, equipment


@dataclass
class EstimationResult:
    """Result of COCOMO estimation."""
    sloc: int
    ksloc: float
    
    # Effort
    person_months: float
    person_years: float
    
    # Schedule
    schedule_months: float
    schedule_years: float
    
    # Team size
    average_developers: float
    
    # Cost
    estimated_cost: float
    
    # Parameters used
    mode: str
    params: COCOMOParams
    cost_params: CostParams


class COCOMOEstimator:
    """Estimate development effort and cost using COCOMO model."""
    
    # Default parameters for each mode (Basic COCOMO)
    MODE_PARAMS: dict[ProjectMode, COCOMOParams] = {
        ProjectMode.ORGANIC: COCOMOParams(
            effort_factor=2.4,
            effort_exponent=1.05,
            schedule_factor=2.5,
            schedule_exponent=0.38,
        ),
        ProjectMode.SEMIDETACHED: COCOMOParams(
            effort_factor=3.0,
            effort_exponent=1.12,
            schedule_factor=2.5,
            schedule_exponent=0.35,
        ),
        ProjectMode.EMBEDDED: COCOMOParams(
            effort_factor=3.6,
            effort_exponent=1.20,
            schedule_factor=2.5,
            schedule_exponent=0.32,
        ),
    }
    
    # Year 2000 defaults (original SLOCCount)
    DEFAULT_COST_PARAMS_2000 = CostParams(
        annual_salary=56286.0,
        overhead_multiplier=2.4,
    )
    
    # Year 2025 estimates (with caveats - very rough)
    DEFAULT_COST_PARAMS_2025 = CostParams(
        annual_salary=120000.0,
        overhead_multiplier=2.8,
    )
    
    def __init__(
        self,
        mode: ProjectMode = ProjectMode.ORGANIC,
        params: Optional[COCOMOParams] = None,
        cost_params: Optional[CostParams] = None,
    ):
        self.mode = mode
        self.params = params or self.MODE_PARAMS[mode]
        self.cost_params = cost_params or self.DEFAULT_COST_PARAMS_2000
    
    def estimate(self, sloc: int) -> EstimationResult:
        """Estimate effort and cost for given SLOC count."""
        if sloc <= 0:
            return EstimationResult(
                sloc=0,
                ksloc=0.0,
                person_months=0.0,
                person_years=0.0,
                schedule_months=0.0,
                schedule_years=0.0,
                average_developers=0.0,
                estimated_cost=0.0,
                mode=self.mode.value,
                params=self.params,
                cost_params=self.cost_params,
            )
        
        ksloc = sloc / 1000.0
        
        # Calculate effort (person-months)
        person_months = (
            self.params.effort_factor * 
            (ksloc ** self.params.effort_exponent)
        )
        person_years = person_months / 12.0
        
        # Calculate schedule (months)
        schedule_months = (
            self.params.schedule_factor * 
            (person_months ** self.params.schedule_exponent)
        )
        schedule_years = schedule_months / 12.0
        
        # Average team size
        average_developers = person_months / schedule_months if schedule_months > 0 else 0.0
        
        # Cost estimation
        # Annual cost per developer = salary * overhead
        annual_cost_per_dev = (
            self.cost_params.annual_salary * 
            self.cost_params.overhead_multiplier
        )
        # Monthly cost per developer
        monthly_cost_per_dev = annual_cost_per_dev / 12.0
        # Total cost = person-months * monthly cost
        estimated_cost = person_months * monthly_cost_per_dev
        
        return EstimationResult(
            sloc=sloc,
            ksloc=ksloc,
            person_months=round(person_months, 2),
            person_years=round(person_years, 2),
            schedule_months=round(schedule_months, 2),
            schedule_years=round(schedule_years, 2),
            average_developers=round(average_developers, 2),
            estimated_cost=round(estimated_cost, 2),
            mode=self.mode.value,
            params=self.params,
            cost_params=self.cost_params,
        )
    
    @classmethod
    def with_custom_params(
        cls,
        effort_factor: float,
        effort_exponent: float,
        schedule_factor: float = 2.5,
        schedule_exponent: float = 0.38,
        annual_salary: float = 56286.0,
        overhead_multiplier: float = 2.4,
    ) -> "COCOMOEstimator":
        """Create estimator with custom parameters."""
        return cls(
            params=COCOMOParams(
                effort_factor=effort_factor,
                effort_exponent=effort_exponent,
                schedule_factor=schedule_factor,
                schedule_exponent=schedule_exponent,
            ),
            cost_params=CostParams(
                annual_salary=annual_salary,
                overhead_multiplier=overhead_multiplier,
            ),
        )
