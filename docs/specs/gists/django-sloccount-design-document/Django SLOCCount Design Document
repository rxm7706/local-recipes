### 4. Main SLOC Counter (`sloccount/core/counter.py`)

```python
"""Main SLOC counting engine."""

from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional
import hashlib

from .detector import LanguageDetector, DetectedLanguage
from .cocomo import COCOMOEstimator, EstimationResult
from ..counters import get_counter_for_language


@dataclass
class FileResult:
    """SLOC count for a single file."""
    filepath: str
    language: str
    sloc: int
    blank_lines: int
    comment_lines: int
    total_lines: int
    is_duplicate: bool = False


@dataclass
class LanguageSummary:
    """Summary for a single language."""
    language: str
    language_name: str
    sloc: int
    files: int
    percentage: float = 0.0


@dataclass
class AnalysisResult:
    """Complete analysis result."""
    total_sloc: int
    total_files: int
    total_languages: int
    
    # Per-file details
    files: list[FileResult] = field(default_factory=list)
    
    # Per-language breakdown
    languages: list[LanguageSummary] = field(default_factory=list)
    
    # Cost estimation
    estimation: Optional[EstimationResult] = None
    
    # Metadata
    skipped_files: int = 0
    duplicate_files: int = 0
    autogenerated_files: int = 0


class SLOCCounter:
    """Main SLOC counting engine."""
    
    def __init__(
        self,
        detector: Optional[LanguageDetector] = None,
        estimator: Optional[COCOMOEstimator] = None,
        skip_duplicates: bool = True,
        skip_autogenerated: bool = True,
    ):
        self.detector = detector or LanguageDetector()
        self.estimator = estimator or COCOMOEstimator()
        self.skip_duplicates = skip_duplicates
        self.skip_autogenerated = skip_autogenerated
        
        # Track file hashes for duplicate detection
        self._seen_hashes: set[str] = set()
    
    def analyze_files(
        self, 
        files: dict[str, str],  # {filepath: content}
    ) -> AnalysisResult:
        """
        Analyze multiple files and return aggregated results.
        
        Args:
            files: Dictionary mapping filepath to file content
        """
        file_results: list[FileResult] = []
        language_counts: dict[str, dict] = {}  # {lang_key: {sloc, files, name}}
        skipped = 0
        duplicates = 0
        autogen = 0
        
        for filepath, content in files.items():
            # Detect language
            detection = self.detector.detect(filepath, content)
            
            if detection is None:
                skipped += 1
                continue
            
            # Check for duplicates
            if self.skip_duplicates:
                file_hash = hashlib.md5(content.encode()).hexdigest()
                if file_hash in self._seen_hashes:
                    duplicates += 1
                    file_results.append(FileResult(
                        filepath=filepath,
                        language=detection.key,
                        sloc=0,
                        blank_lines=0,
                        comment_lines=0,
                        total_lines=len(content.split('\n')),
                        is_duplicate=True,
                    ))
                    continue
                self._seen_hashes.add(file_hash)
            
            # Check for auto-generated
            if self.skip_autogenerated and self.detector.is_autogenerated(content):
                autogen += 1
                skipped += 1
                continue
            
            # Get appropriate counter
            counter = get_counter_for_language(detection.key)
            
            # Count SLOC
            result = counter.count(content, filepath)
            
            file_results.append(FileResult(
                filepath=filepath,
                language=detection.key,
                sloc=result.sloc,
                blank_lines=result.blank_lines,
                comment_lines=result.comment_lines,
                total_lines=result.total_lines,
            ))
            
            # Aggregate by language
            if detection.key not in language_counts:
                language_counts[detection.key] = {
                    "sloc": 0,
                    "files": 0,
                    "name": detection.name,
                }
            language_counts[detection.key]["sloc"] += result.sloc
            language_counts[detection.key]["files"] += 1
        
        # Calculate totals
        total_sloc = sum(f.sloc for f in file_results if not f.is_duplicate)
        total_files = len([f for f in file_results if not f.is_duplicate])
        
        # Create language summaries with percentages
        language_summaries = []
        for lang_key, data in language_counts.items():
            percentage = (data["sloc"] / total_sloc * 100) if total_sloc > 0 else 0
            language_summaries.append(LanguageSummary(
                language=lang_key,
                language_name=data["name"],
                sloc=data["sloc"],
                files=data["files"],
                percentage=round(percentage, 2),
            ))
        
        # Sort by SLOC descending
        language_summaries.sort(key=lambda x: x.sloc, reverse=True)
        
        # Cost estimation
        estimation = self.estimator.estimate(total_sloc)
        
        return AnalysisResult(
            total_sloc=total_sloc,
            total_files=total_files,
            total_languages=len(language_summaries),
            files=file_results,
            languages=language_summaries,
            estimation=estimation,
            skipped_files=skipped,
            duplicate_files=duplicates,
            autogenerated_files=autogen,
        )
    
    def analyze_single_file(
        self, 
        content: str, 
        filename: str,
    ) -> AnalysisResult:
        """Analyze a single pasted code file."""
        return self.analyze_files({filename: content})
    
    def reset(self):
        """Reset duplicate tracking for new analysis."""
        self._seen_hashes.clear()
