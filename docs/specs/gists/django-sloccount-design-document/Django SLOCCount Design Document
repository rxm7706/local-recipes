class AnalyzeZipFileView(APIView):
    """Analyze an uploaded ZIP file."""
    
    parser_classes = [MultiPartParser]
    
    def post(self, request):
        if 'file' not in request.FILES:
            return Response(
                {"error": "No file uploaded"},
                status=status.HTTP_400_BAD_REQUEST
            )
        
        uploaded_file = request.FILES['file']
        
        if not uploaded_file.name.endswith('.zip'):
            return Response(
                {"error": "File must be a ZIP archive"},
                status=status.HTTP_400_BAD_REQUEST
            )
        
        # Parse COCOMO params from form data
        cocomo_params = {}
        for key in ['effort_factor', 'effort_exponent', 'schedule_factor', 
                    'schedule_exponent', 'annual_salary', 'overhead_multiplier']:
            if key in request.data:
                cocomo_params[key] = float(request.data[key])
        
        try:
            # Process ZIP file
            processor = ZipProcessor()
            files = processor.extract_files(uploaded_file)
            
            # Analyze
            estimator = self._create_estimator(cocomo_params)
            counter = SLOCCounter(estimator=estimator)
            result = counter.analyze_files(files)
            
            return Response(
                AnalysisResultSerializer(result).data,
                status=status.HTTP_200_OK
            )
        
        except Exception as e:
            return Response(
                {"error": str(e)},
                status=status.HTTP_400_BAD_REQUEST
            )
    
    def _create_estimator(self, params: dict) -> COCOMOEstimator:
        if not params:
            return COCOMOEstimator()
        
        return COCOMOEstimator.with_custom_params(
            effort_factor=params.get('effort_factor', 2.4),
            effort_exponent=params.get('effort_exponent', 1.05),
            schedule_factor=params.get('schedule_factor', 2.5),
            schedule_exponent=params.get('schedule_exponent', 0.38),
            annual_salary=params.get('annual_salary', 56286.0),
            overhead_multiplier=params.get('overhead_multiplier', 2.4),
        )


class SupportedLanguagesView(APIView):
    """List supported programming languages."""
    
    def get(self, request):
        from .core.detector import LanguageDetector
        
        detector = LanguageDetector()
        
        # Get unique languages
        languages = set(detector.EXTENSION_MAP.values())
        
        # Create response with names
        language_list = []
        for lang_key in sorted(languages):
            detection = detector._create_detection(lang_key)
            language_list.append({
                "key": lang_key,
                "name": detection.name,
            })
        
        return Response({"languages": language_list})
