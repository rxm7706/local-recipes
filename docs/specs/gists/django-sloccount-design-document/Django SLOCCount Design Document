"""REST API views for SLOC counting."""

from rest_framework import status
from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework.parsers import MultiPartParser, JSONParser

from .serializers import (
    PastedCodeSerializer,
    GitHubRepoSerializer,
    AnalysisResultSerializer,
    COCOMOParamsSerializer,
)
from .core.counter import SLOCCounter
from .core.cocomo import COCOMOEstimator, CostParams, COCOMOParams
from .core.github import GitHubFetcher
from .core.zip_processor import ZipProcessor


class AnalyzePastedCodeView(APIView):
    """Analyze pasted source code."""
    
    parser_classes = [JSONParser]
    
    def post(self, request):
        serializer = PastedCodeSerializer(data=request.data)
        
        if not serializer.is_valid():
            return Response(
                serializer.errors, 
                status=status.HTTP_400_BAD_REQUEST
            )
        
        code = serializer.validated_data['code']
        filename = serializer.validated_data.get('filename', 'code.txt')
        cocomo_params = serializer.validated_data.get('cocomo_params', {})
        
        # Create estimator with custom params if provided
        estimator = self._create_estimator(cocomo_params)
        counter = SLOCCounter(estimator=estimator)
        
        result = counter.analyze_single_file(code, filename)
        
        return Response(
            AnalysisResultSerializer(result).data,
            status=status.HTTP_200_OK
        )
    
    def _create_estimator(self, params: dict) -> COCOMOEstimator:
        """Create estimator from request parameters."""
        if not params:
            return COCOMOEstimator()
        
        return COCOMOEstimator.with_custom_params(
            effort_factor=params.get('effort_factor', 2.4),
            effort_exponent=params.get('effort_exponent', 1.05),
            schedule_factor=params.get('schedule_factor', 2.5),
            schedule_exponent=params.get('schedule_exponent', 0.38),
            annual_salary=params.get('annual_salary', 56286.0),
            overhead_multiplier=params.get('overhead_multiplier', 2.4),
        )


class AnalyzeGitHubRepoView(APIView):
    """Analyze a GitHub repository."""
    
    parser_classes = [JSONParser]
    
    def post(self, request):
        serializer = GitHubRepoSerializer(data=request.data)
        
        if not serializer.is_valid():
            return Response(
                serializer.errors,
                status=status.HTTP_400_BAD_REQUEST
            )
        
        repo_url = serializer.validated_data['repo_url']
        branch = serializer.validated_data.get('branch', 'main')
        cocomo_params = serializer.validated_data.get('cocomo_params', {})
        
        try:
            # Fetch repository files
            fetcher = GitHubFetcher()
            files = fetcher.fetch_repository(repo_url, branch)
            
            # Analyze
            estimator = self._create_estimator(cocomo_params)
            counter = SLOCCounter(estimator=estimator)
            result = counter.analyze_files(files)
            
            return Response(
                AnalysisResultSerializer(result).data,
                status=status.HTTP_200_OK
            )
        
        except Exception as e:
            return Response(
                {"error": str(e)},
                status=status.HTTP_400_BAD_REQUEST
            )
    
    def _create_estimator(self, params: dict) -> COCOMOEstimator:
        if not params:
            return COCOMOEstimator()
        
        return COCOMOEstimator.with_custom_params(
            effort_factor=params.get('effort_factor', 2.4),
            effort_exponent=params.get('effort_exponent', 1.05),
            schedule_factor=params.get('schedule_factor', 2.5),
            schedule_exponent=params.get('schedule_exponent', 0.38),
