### 2. Base Counter (`sloccount/counters/base.py`)

```python
"""Base class for language-specific SLOC counters."""

from abc import ABC, abstractmethod
from dataclasses import dataclass
from typing import Optional


@dataclass
class CountResult:
    """Result of counting SLOC for a single file."""
    sloc: int
    blank_lines: int
    comment_lines: int
    total_lines: int
    language: str
    filepath: str


class BaseCounter(ABC):
    """Abstract base class for SLOC counters."""
    
    # Override in subclasses
    LANGUAGE_NAME: str = "Unknown"
    LANGUAGE_KEY: str = "unknown"
    
    # Comment syntax - override in subclasses
    LINE_COMMENT: Optional[str] = None      # e.g., "//" or "#"
    BLOCK_COMMENT_START: Optional[str] = None  # e.g., "/*"
    BLOCK_COMMENT_END: Optional[str] = None    # e.g., "*/"
    
    # String delimiters that might contain comment-like characters
    STRING_DELIMITERS: list[str] = ['"', "'"]
    
    def count(self, content: str, filepath: str = "") -> CountResult:
        """Count SLOC in the given content."""
        lines = content.split('\n')
        
        sloc = 0
        blank_lines = 0
        comment_lines = 0
        in_block_comment = False
        in_string = False
        string_char = None
        
        for line in lines:
            stripped = line.strip()
            
            # Empty line
            if not stripped:
                blank_lines += 1
                continue
            
            # Process the line
            is_code, is_comment, in_block_comment = self._classify_line(
                stripped, in_block_comment
            )
            
            if is_code:
                sloc += 1
            elif is_comment:
                comment_lines += 1
            else:
                blank_lines += 1
        
        return CountResult(
            sloc=sloc,
            blank_lines=blank_lines,
            comment_lines=comment_lines,
            total_lines=len(lines),
            language=self.LANGUAGE_KEY,
            filepath=filepath
        )
    
    def _classify_line(
        self, 
        line: str, 
        in_block_comment: bool
    ) -> tuple[bool, bool, bool]:
        """
        Classify a line as code, comment, or blank.
        
        Returns:
            (is_code, is_comment, still_in_block_comment)
        """
        # Handle block comment continuation
        if in_block_comment:
            if self.BLOCK_COMMENT_END and self.BLOCK_COMMENT_END in line:
                # Block comment ends on this line
                idx = line.index(self.BLOCK_COMMENT_END)
                remaining = line[idx + len(self.BLOCK_COMMENT_END):].strip()
                
                if remaining:
                    # There's code after the comment end
                    return (True, False, False)
                return (False, True, False)
            return (False, True, True)
        
        # Check for line comment at start
        if self.LINE_COMMENT and line.startswith(self.LINE_COMMENT):
            return (False, True, False)
        
        # Check for block comment start
        if self.BLOCK_COMMENT_START and self.BLOCK_COMMENT_START in line:
            idx = line.index(self.BLOCK_COMMENT_START)
            
            # Check if it's inside a string
            if not self._is_in_string(line, idx):
                # Check if block comment ends on same line
                after_start = line[idx + len(self.BLOCK_COMMENT_START):]
                
                if self.BLOCK_COMMENT_END and self.BLOCK_COMMENT_END in after_start:
                    # Comment is fully contained in line
                    before_comment = line[:idx].strip()
                    end_idx = after_start.index(self.BLOCK_COMMENT_END)
                    after_comment = after_start[end_idx + len(self.BLOCK_COMMENT_END):].strip()
                    
                    if before_comment or after_comment:
                        return (True, False, False)
                    return (False, True, False)
                else:
                    # Block comment starts, doesn't end
                    before = line[:idx].strip()
                    if before:
                        return (True, False, True)
                    return (False, True, True)
        
        # It's a code line
        return (True, False, False)
    
    def _is_in_string(self, line: str, position: int) -> bool:
        """Check if position is inside a string literal."""
        in_string = False
        string_char = None
        escape_next = False
        
        for i, char in enumerate(line):
            if i >= position:
                return in_string
            
            if escape_next:
                escape_next = False
                continue
            
            if char == '\\':
                escape_next = True
                continue
            
            if char in self.STRING_DELIMITERS:
                if not in_string:
                    in_string = True
                    string_char = char
                elif char == string_char:
                    in_string = False
                    string_char = None
        
        return in_string
