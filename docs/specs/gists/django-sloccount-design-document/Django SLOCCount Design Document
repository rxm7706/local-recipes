        ".swift": "swift",
        ".m": "objc",
        ".mm": "objc",
        
        # Haskell
        ".hs": "haskell",
        ".lhs": "haskell",
        
        # LISP family
        ".lisp": "lisp",
        ".lsp": "lisp",
        ".cl": "lisp",
        ".el": "elisp",
        ".scm": "scheme",
        ".clj": "clojure",
        ".cljs": "clojure",
        
        # ML family
        ".ml": "ocaml",
        ".mli": "ocaml",
        ".fs": "fsharp",
        ".fsx": "fsharp",
        
        # Fortran
        ".f": "fortran",
        ".for": "fortran",
        ".f77": "fortran",
        ".f90": "fortran90",
        ".f95": "fortran90",
        
        # Assembly
        ".asm": "asm",
        ".s": "asm",
        ".S": "asm",
        
        # Makefile
        "Makefile": "makefile",
        "makefile": "makefile",
        ".mk": "makefile",
        
        # Config/Data (usually not counted but detected)
        ".json": "json",
        ".yaml": "yaml",
        ".yml": "yaml",
        ".toml": "toml",
        ".xml": "xml",
        ".md": "markdown",
        ".rst": "rst",
    }
    
    # Files to skip
    SKIP_PATTERNS: list[str] = [
        r"\.git/",
        r"__pycache__/",
        r"node_modules/",
        r"\.pyc$",
        r"\.pyo$",
        r"\.so$",
        r"\.o$",
        r"\.a$",
        r"\.dll$",
        r"\.exe$",
        r"\.min\.js$",
        r"\.min\.css$",
        r"\.map$",
        r"package-lock\.json$",
        r"yarn\.lock$",
        r"Pipfile\.lock$",
        r"poetry\.lock$",
    ]
    
    # Auto-generated file markers (in first 15 lines)
    AUTOGEN_MARKERS: list[str] = [
        "generated automatically",
        "automatically generated",
        "this is a generated file",
        "do not edit",
        "auto-generated",
        "autogenerated",
        "machine generated",
    ]
    
    def detect(self, filepath: str, content: Optional[str] = None) -> Optional[DetectedLanguage]:
        """Detect language from filepath and optionally content."""
        path = Path(filepath)
        
        # Check skip patterns
        for pattern in self.SKIP_PATTERNS:
            if re.search(pattern, str(path)):
                return None
        
        # Check extension
        ext = path.suffix.lower()
        name = path.name
        
        # Check by filename first (for Makefile, etc.)
        if name in self.EXTENSION_MAP:
            return self._create_detection(self.EXTENSION_MAP[name])
        
        # Check by extension
        if ext in self.EXTENSION_MAP:
            lang_key = self.EXTENSION_MAP[ext]
            
            # Special handling for .h files (could be C or C++)
            if ext == ".h" and content:
                lang_key = self._detect_header_language(content)
            
            return self._create_detection(lang_key)
        
        # Check shebang if content available
        if content:
            shebang_lang = self._detect_from_shebang(content)
            if shebang_lang:
                return self._create_detection(shebang_lang)
        
        return None
    
    def is_autogenerated(self, content: str) -> bool:
        """Check if file content indicates auto-generation."""
        # Check first 15 lines
        lines = content.split('\n')[:15]
        text = '\n'.join(lines).lower()
        
        return any(marker in text for marker in self.AUTOGEN_MARKERS)
    
    def _detect_header_language(self, content: str) -> str:
        """Detect if .h file is C or C++ based on content."""
        cpp_indicators = [
            r'\bclass\s+\w+',
            r'\btemplate\s*<',
            r'\bnamespace\s+\w+',
            r'\bprivate:',
            r'\bpublic:',
            r'\bprotected:',
            r'\bvirtual\s+',
            r'::\w+',
        ]
        
        for pattern in cpp_indicators:
            if re.search(pattern, content):
                return "cpp"
        
        return "c"
    
    def _detect_from_shebang(self, content: str) -> Optional[str]:
        """Detect language from shebang line."""
        first_line = content.split('\n')[0].strip()
        
        if not first_line.startswith('#!'):
            return None
        
        shebang_map = {
            'python': 'python',
            'python3': 'python',
            'ruby': 'ruby',
            'perl': 'perl',
            'bash': 'shell',
            'sh': 'shell',
            'zsh': 'shell',
            'node': 'javascript',
            'php': 'php',
        }
        
        for interpreter, lang in shebang_map.items():
            if interpreter in first_line:
                return lang
        
        return None
    
    def _create_detection(self, key: str) -> DetectedLanguage:
        """Create DetectedLanguage from key."""
        name_map = {
            "python": "Python",
            "javascript": "JavaScript",
            "typescript": "TypeScript",
            "c": "C",
            "c_header": "C/C++ Header",
            "cpp": "C++",
            "java": "Java",
            "kotlin": "Kotlin",
            "csharp": "C#",
            "go": "Go",
            "rust": "Rust",
            "ruby": "Ruby",
            "php": "PHP",
            "shell": "Shell",
            "cshell": "C Shell",
            "perl": "Perl",
            "sql": "SQL",
            "html": "HTML",
            "css": "CSS",
            "scss": "SCSS",
            "sass": "Sass",
            "less": "Less",
            "swift": "Swift",
            "objc": "Objective-C",
            "haskell": "Haskell",
            "lisp": "LISP",
            "elisp": "Emacs Lisp",
            "scheme": "Scheme",
            "clojure": "Clojure",
            "ocaml": "OCaml",
            "fsharp": "F#",
            "fortran": "Fortran",
            "fortran90": "Fortran 90",
            "asm": "Assembly",
            "makefile": "Makefile",
            "json": "JSON",
            "yaml": "YAML",
            "toml": "TOML",
            "xml": "XML",
            "markdown": "Markdown",
            "rst": "reStructuredText",
        }
        
        return DetectedLanguage(
            name=name_map.get(key, key.title()),
            key=key,
            counter_class=f"{key}_counter"
        )
