diff -Naur mybmad-patch-a/web/src/lib/ui-locale.ts mybmad-patch-b/web/src/lib/ui-locale.ts
--- a/web/src/lib/ui-locale.ts	1969-12-31 18:00:00.000000000 -0600
+++ b/web/src/lib/ui-locale.ts	2026-09-13 17:59:15.850414427 -0500
@@ -0,0 +1,118 @@
+/**
+ * Runtime UI locale for the conda-packaged MyBMAD Dashboard.
+ *
+ * Upstream hard-codes French copy. The launcher sets MYBMAD_LOCALE (default
+ * "en"). Unknown values fall back to English. "fr" keeps the upstream strings.
+ */
+
+export type UiLocale = "en" | "fr";
+
+export function resolveUiLocale(raw?: string | null): UiLocale {
+  const source = (raw ?? process.env.MYBMAD_LOCALE ?? "en").trim().toLowerCase();
+  const token = source.split(/[-_]/)[0] ?? "en";
+  return token === "fr" ? "fr" : "en";
+}
+
+export type LoginCopy = {
+  emailPasswordRequired: string;
+  passwordTooShort: string;
+  nameRequired: string;
+  registrationDisabled: string;
+  registrationFailed: string;
+  badCredentials: string;
+  unexpected: string;
+  loginFailed: string;
+  createAccount: string;
+  signInPrompt: string;
+  namePlaceholder: string;
+  passwordPlaceholder: string;
+  signUp: string;
+  signIn: string;
+  alreadyHaveAccount: string;
+  noAccount: string;
+  or: string;
+  continueGithub: string;
+};
+
+const LOGIN: Record<UiLocale, LoginCopy> = {
+  en: {
+    emailPasswordRequired: "Email and password are required.",
+    passwordTooShort: "Password must be at least 8 characters.",
+    nameRequired: "Name is required to register.",
+    registrationDisabled: "Registration is disabled on this server.",
+    registrationFailed: "Registration failed.",
+    badCredentials: "Incorrect email or password.",
+    unexpected: "An unexpected error occurred.",
+    loginFailed: "Sign-in failed. Please try again.",
+    createAccount: "Create an account",
+    signInPrompt: "Sign in to your dashboard",
+    namePlaceholder: "Name",
+    passwordPlaceholder: "Password",
+    signUp: "Sign up",
+    signIn: "Sign in",
+    alreadyHaveAccount: "Already have an account? Sign in",
+    noAccount: "No account? Sign up",
+    or: "or",
+    continueGithub: "Continue with GitHub",
+  },
+  fr: {
+    emailPasswordRequired: "Email et mot de passe requis.",
+    passwordTooShort: "Le mot de passe doit contenir au moins 8 caractères.",
+    nameRequired: "Le nom est requis pour l'inscription.",
+    registrationDisabled: "L'inscription est désactivée sur ce serveur.",
+    registrationFailed: "Erreur lors de l'inscription.",
+    badCredentials: "Email ou mot de passe incorrect.",
+    unexpected: "Une erreur inattendue s'est produite.",
+    loginFailed: "Échec de la connexion. Veuillez réessayer.",
+    createAccount: "Créer un compte",
+    signInPrompt: "Connectez-vous à votre dashboard",
+    namePlaceholder: "Nom",
+    passwordPlaceholder: "Mot de passe",
+    signUp: "S'inscrire",
+    signIn: "Se connecter",
+    alreadyHaveAccount: "Déjà un compte ? Se connecter",
+    noAccount: "Pas de compte ? S'inscrire",
+    or: "ou",
+    continueGithub: "Continuer avec GitHub",
+  },
+};
+
+export function loginCopy(locale: UiLocale): LoginCopy {
+  return LOGIN[locale];
+}
+
+const ERRORS: Record<UiLocale, Record<string, string>> = {
+  en: {
+    DB_ERROR: "Something went wrong. Please try again.",
+    GITHUB_ERROR: "Error communicating with GitHub.",
+    FS_ERROR: "Error reading the file system.",
+    LOCAL_DISABLED: "Local mode is not enabled on this server.",
+    PATH_NOT_FOUND:
+      "This path does not exist on the server. Local-folder support requires a self-hosted deployment.",
+    PATH_STALE: "This local folder no longer exists or has been moved.",
+    REGISTRATION_DISABLED: "Registration is disabled on this server.",
+    UNEXPECTED: "An unexpected error occurred.",
+    RATE_LIMIT: "Too many requests",
+  },
+  fr: {
+    DB_ERROR: "Une erreur s'est produite. Veuillez réessayer.",
+    GITHUB_ERROR: "Erreur lors de la communication avec GitHub.",
+    FS_ERROR: "Erreur lors de la lecture du système de fichiers.",
+    LOCAL_DISABLED: "Le mode local n'est pas activé sur ce serveur.",
+    PATH_NOT_FOUND:
+      "Ce chemin n'existe pas sur le serveur. La fonctionnalité dossiers locaux nécessite un déploiement self-hosted.",
+    PATH_STALE: "Ce dossier local n'existe plus ou a été déplacé.",
+    REGISTRATION_DISABLED: "L'inscription est désactivée sur ce serveur.",
+    UNEXPECTED: "Une erreur inattendue s'est produite.",
+    RATE_LIMIT: "Trop de requêtes",
+  },
+};
+
+export function errorMessage(code: string, locale?: UiLocale): string {
+  const bag = ERRORS[locale ?? resolveUiLocale()];
+  return bag[code] ?? bag.UNEXPECTED;
+}
+
+export function rateLimitMessage(locale?: UiLocale): string {
+  return errorMessage("RATE_LIMIT", locale);
+}
