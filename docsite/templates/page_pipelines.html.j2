{% extends "shell_page.html.j2" %}
{%- import "kedro_viz_export.html.j2" as KV -%}
{#- Story 42.2 (CAP-60): /dashboard/index.html, the one page under /dashboard/ herald renders, in
    front of the vendored Kedro-Viz bundle no template edits. Rendered only when the export is in
    the build input; `rel` climbs from /dashboard/ back to the /herald/ mount. -#}
{% block body %}
<div class="page">

  <div class="lander">
    <div class="kicker"><span class="dot"></span>{{ neighbour.eyebrow }}</div>
    <h1>{{ neighbour.label }}</h1>
    <p class="blurb">{{ neighbour.blurb }}</p>
    {{ KV.provenance(export) }}
  </div>

  <div class="card-grid">
    <a class="card" href="kedro-viz/">
      <span class="card-eyebrow">{{ neighbour.eyebrow }}</span>
      <h3>The pipeline graph</h3>
      <p>The interactive Kedro-Viz view of the pyforge-atlas DAG, mounted from atlas's kedro-viz-export artifact.</p>
      <span class="card-go">Open {{ neighbour.label }} &rarr;</span>
    </a>
  </div>

  <footer>
    <span>Mounted from the export's manifest.json; the bundle itself is published unmodified.</span>
    <span>Site rebuilt {{ built_at }}</span>
  </footer>

</div>
{% endblock %}
