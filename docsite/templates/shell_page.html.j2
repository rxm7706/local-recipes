{%- import "blocks.html.j2" as B with context -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description | e }}">
<meta property="og:title" content="{{ page_title | e }}">
<meta property="og:description" content="{{ page_description | e }}">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>{{ site.favicon }}</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ rel }}assets/site.css">
</head>
<body>

<header class="site-nav">
  <div class="site-nav-inner">
    <a class="site-brand" href="{{ rel }}index.html"><span class="spark"></span>{{ site.short_name }}</a>
    <ul>
      {%- for item in site.nav %}
      <li><a class="nav-link" href="{{ rel }}{{ item.href }}"{% if item.key == page_key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      {%- for n in site.neighbours | default([]) %}
      <li><a class="nav-link nav-neighbour" href="{{ rel }}{{ n.href }}">{{ n.label }}</a></li>
      {%- endfor %}
    </ul>
    <span class="nav-spacer"></span>
    <span class="stamp">Built {{ built_at }}{% if commit %} · {{ commit }}{% endif %}</span>
  </div>
</header>

{% block body %}{% endblock %}

<script>
// Any page can carry `.shot-frame[data-preview]` cards (the infographic
// gallery, a deck family page, the decks index) -- each is 100KB-6MB of
// self-contained HTML, so a preview is only attached once its card is near
// the viewport, and never at all where IntersectionObserver is missing,
// which leaves a titled placeholder rather than a broken frame. A no-op on
// a page with no such cards.
(function () {
  var frames = Array.prototype.slice.call(document.querySelectorAll('.shot-frame[data-preview]'));
  if (!frames.length || typeof IntersectionObserver === 'undefined') return;

  function mount(frame) {
    if (frame.dataset.mounted) return;
    frame.dataset.mounted = '1';
    var f = document.createElement('iframe');
    f.setAttribute('title', '');
    f.setAttribute('aria-hidden', 'true');
    f.setAttribute('tabindex', '-1');
    f.setAttribute('scrolling', 'no');
    f.setAttribute('loading', 'lazy');
    f.addEventListener('load', function () { frame.classList.add('is-loaded'); });
    f.src = frame.dataset.preview;
    frame.appendChild(f);
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { mount(e.target); io.unobserve(e.target); }
    });
  }, { rootMargin: '300px 0px' });

  frames.forEach(function (f) { io.observe(f); });
})();
</script>

</body>
</html>
