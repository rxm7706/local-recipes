{# ------------------------------------------------------------------
   One macro per block type in site/content/dossier.yml.
   These render identically for the GitHub Pages build and the
   standalone artifact build — there is exactly one implementation.
   ------------------------------------------------------------------ #}

{%- macro v(token) -%}
{%- if token and token.startswith('--') -%}var({{ token }}){%- else -%}{{ token }}{%- endif -%}
{%- endmacro -%}

{%- macro lede(b) %}
        <p class="lede">{{ b.md | md }}</p>
{%- endmacro %}

{%- macro quote(b) %}
        <blockquote class="station-quote">{{ b.md | md }}</blockquote>
{%- endmacro %}

{%- macro stats(b) %}
        <div class="stat-row">
          {%- for s in b.stats %}
          <div class="s"><b>{{ s.value | md }}</b><span>{{ s.label | md }}</span></div>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro h3(b) %}
        <h3>{% if b.num %}<span class="h3-num">{{ b.num | md }}</span>{% endif %}{{ b.text | md }}</h3>
{%- endmacro %}

{%- macro prose(b) %}
        <div class="prose">
          {%- for p in b.body %}
          <p>{{ p | md }}</p>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro note(b) %}
        <p class="soft-note">{{ b.md | md }}</p>
{%- endmacro %}

{%- macro verify(b) %}
        <p class="verify-note">{{ b.md | md }}</p>
{%- endmacro %}

{%- macro table(b) %}
        <div class="table-wrap">
          <table>
            <thead><tr>{% for h in b.headers %}<th>{{ h | md }}</th>{% endfor %}</tr></thead>
            <tbody>
              {%- for row in b.rows %}
              <tr>{% for cell in row.cells %}<td{% if row.mono and row.mono[loop.index0] %} class="mono"{% endif %}>{{ cell | md }}</td>{% endfor %}</tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
{%- endmacro %}

{%- macro callout(b) %}
        <div class="callout{% if b.tone in ('red','green') %} {{ b.tone }}{% endif %}">
          {%- if b.label %}
          <span class="label">{{ b.label | md }}</span>
          {%- endif %}
          {%- for p in b.body %}
          <p>{{ p | md }}</p>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro finding(b) %}
        <div class="find-box{% if b.alarm %} red{% endif %}"{% if b.accent %} style="border-left-color:{{ v(b.accent) }}"{% endif %}>
          {%- if b.label %}
          <span class="flabel"{% if b.accent %} style="color:{{ v(b.accent) }}"{% endif %}>{{ b.label | md }}</span>
          {%- endif %}
          {%- for p in b.body %}
          <p>{{ p | md }}</p>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro chips(b) %}
        <div class="chips">
          {%- for c in b.chips %}<span class="chip">{{ c | md }}</span>{% endfor %}
        </div>
{%- endmacro %}

{%- macro relations(b) %}
        <ul class="rel-list">
          {%- for item in b['items'] %}
          <li><span class="rel-arrow">{{ item.glyph | md }}</span> {{ item.md | md }}</li>
          {%- endfor %}
        </ul>
{%- endmacro %}

{%- macro lattice(b) %}
        <div class="lattice-wrap">
          <div class="lattice">
            {%- for r in b.rungs %}
            <div class="rung"{% if r.tone %} style="background:{{ v(r.tone) }}"{% endif %}><span class="exit"{% if r.exit_tone %} style="background:{{ v(r.exit_tone) }}"{% endif %}>{{ r.exit | md }}</span><span class="name">{{ r.name | md }}</span><span class="desc">{{ r.desc | md }}</span></div>
            {%- endfor %}
          </div>
          {%- if b.note %}
          <p class="lattice-note">{{ b.note | md }}</p>
          {%- endif %}
        </div>
{%- endmacro %}

{%- macro engines(b) %}
        <div class="engines">
          {%- for e in b.engines %}
          <div class="engine">
            <h4>{{ e.name | md }}</h4>
            <span class="verb">{{ e.verb | md }}</span>
            {%- for p in e.body %}
            <p>{{ p | md }}</p>
            {%- endfor %}
          </div>
          {%- endfor %}
        </div>
{%- endmacro %}

{#- dispatcher: render any block by its declared type -#}
{%- macro render(b) -%}
{%- if   b.type == 'lede'       %}{{ lede(b) }}
{%- elif b.type == 'quote'      %}{{ quote(b) }}
{%- elif b.type == 'stats'      %}{{ stats(b) }}
{%- elif b.type == 'h3'         %}{{ h3(b) }}
{%- elif b.type == 'prose'      %}{{ prose(b) }}
{%- elif b.type == 'note'       %}{{ note(b) }}
{%- elif b.type == 'verify'     %}{{ verify(b) }}
{%- elif b.type == 'table'      %}{{ table(b) }}
{%- elif b.type == 'callout'    %}{{ callout(b) }}
{%- elif b.type == 'finding'    %}{{ finding(b) }}
{%- elif b.type == 'chips'      %}{{ chips(b) }}
{%- elif b.type == 'relations'  %}{{ relations(b) }}
{%- elif b.type == 'lattice'    %}{{ lattice(b) }}
{%- elif b.type == 'engines'    %}{{ engines(b) }}
{%- else %}{{ raise_unknown(b.type) }}
{%- endif -%}
{%- endmacro -%}
