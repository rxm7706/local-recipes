{# ------------------------------------------------------------------
   One macro per block type in site/content/dossier.yml.
   These render identically for the GitHub Pages build and the
   standalone artifact build — there is exactly one implementation.
   ------------------------------------------------------------------ #}

{%- macro v(token) -%}
{%- if token and token.startswith('--') -%}var({{ token }}){%- else -%}{{ token }}{%- endif -%}
{%- endmacro -%}

{%- macro lede(b) %}
        <p class="lede">{{ b.md | md }}</p>
{%- endmacro %}

{%- macro quote(b) %}
        <blockquote class="station-quote">{{ b.md | md }}</blockquote>
{%- endmacro %}

{%- macro stats(b) %}
        <div class="stat-row">
          {%- for s in b.stats %}
          <div class="s"><b>{{ s.value | md }}</b><span>{{ s.label | md }}</span></div>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro h3(b) %}
        <h3>{% if b.num %}<span class="h3-num">{{ b.num | md }}</span>{% endif %}{{ b.text | md }}</h3>
{%- endmacro %}

{%- macro prose(b) %}
        <div class="prose">
          {%- for p in b.body %}
          <p>{{ p | md }}</p>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro note(b) %}
        <p class="soft-note">{{ b.md | md }}</p>
{%- endmacro %}

{%- macro verify(b) %}
        <p class="verify-note">{{ b.md | md }}</p>
{%- endmacro %}

{%- macro table(b) %}
        <div class="table-wrap">
          <table>
            <thead><tr>{% for h in b.headers %}<th>{{ h | md }}</th>{% endfor %}</tr></thead>
            <tbody>
              {%- for row in b.rows %}
              <tr>{% for cell in row.cells %}<td{% if row.mono and row.mono[loop.index0] %} class="mono"{% endif %}>{{ cell | md }}</td>{% endfor %}</tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
{%- endmacro %}

{%- macro callout(b) %}
        <div class="callout{% if b.tone in ('red','green') %} {{ b.tone }}{% endif %}">
          {%- if b.label %}
          <span class="label">{{ b.label | md }}</span>
          {%- endif %}
          {%- for p in b.body %}
          <p>{{ p | md }}</p>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro finding(b) %}
        <div class="find-box{% if b.alarm %} red{% endif %}"{% if b.accent %} style="border-left-color:{{ v(b.accent) }}"{% endif %}>
          {%- if b.label %}
          <span class="flabel"{% if b.accent %} style="color:{{ v(b.accent) }}"{% endif %}>{{ b.label | md }}</span>
          {%- endif %}
          {%- for p in b.body %}
          <p>{{ p | md }}</p>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro chips(b) %}
        <div class="chips">
          {%- for c in b.chips %}<span class="chip">{{ c | md }}</span>{% endfor %}
        </div>
{%- endmacro %}

{%- macro relations(b) %}
        <ul class="rel-list">
          {%- for item in b['items'] %}
          <li><span class="rel-arrow">{{ item.glyph | md }}</span> {{ item.md | md }}</li>
          {%- endfor %}
        </ul>
{%- endmacro %}

{%- macro lattice(b) %}
        <div class="lattice-wrap">
          <div class="lattice">
            {%- for r in b.rungs %}
            <div class="rung"{% if r.tone %} style="background:{{ v(r.tone) }}"{% endif %}><span class="exit"{% if r.exit_tone %} style="background:{{ v(r.exit_tone) }}"{% endif %}>{{ r.exit | md }}</span><span class="name">{{ r.name | md }}</span><span class="desc">{{ r.desc | md }}</span></div>
            {%- endfor %}
          </div>
          {%- if b.note %}
          <p class="lattice-note">{{ b.note | md }}</p>
          {%- endif %}
        </div>
{%- endmacro %}

{%- macro engines(b) %}
        <div class="engines">
          {%- for e in b.engines %}
          <div class="engine">
            <h4>{{ e.name | md }}</h4>
            <span class="verb">{{ e.verb | md }}</span>
            {%- for p in e.body %}
            <p>{{ p | md }}</p>
            {%- endfor %}
          </div>
          {%- endfor %}
        </div>
{%- endmacro %}

{%- macro scorecards(b) %}
        <div class="lens-bar" role="tablist" aria-label="Scorecard lens">
          {%- for l in b.lenses %}
          <button type="button" class="lens-btn" data-lens="{{ l.key }}" role="tab" aria-selected="false">{{ l.label | md }}</button>
          {%- endfor %}
        </div>
        <p class="lens-sub" id="lens-sub" aria-live="polite"></p>

        <div class="sc-table-wrap">
          <table class="sc-table">
            <thead><tr><th>Station</th><th>Epic</th><th>Open</th><th>What it delivers</th><th>Signal</th></tr></thead>
            <tbody id="sc-body">
              {%- for r in b.rows %}
              <tr class="sc-row" data-open="{{ r.open }}"{% for k, lens in r.lenses.items() %} data-{{ k }}="{{ 1 if lens.hit else 0 }}" data-{{ k }}-note="{{ lens.note | e }}"{% endfor %}>
                <td class="sc-station"><span class="dot" style="background:{{ v(r.accent) }}"></span>{{ r.station | md }}</td>
                <td class="sc-epic"><b>{{ r.epic_num | e }}</b>{{ r.epic | md }}</td>
                <td class="sc-counts">{{ r.counts_html }}</td>
                <td class="sc-deliver">{{ r.delivers | md }}</td>
                <td class="sc-note"></td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        {%- if b.footnote %}
        <p class="sc-proto-note">{{ b.footnote | md }}</p>
        {%- endif %}

        <script>
        (function(){
          var LENSES = {{ lens_copy | tojson }};
          var tbody = document.getElementById('sc-body');
          var sub = document.getElementById('lens-sub');
          var buttons = Array.prototype.slice.call(document.querySelectorAll('.lens-btn'));
          if (!tbody || !sub || !buttons.length) return;
          var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));

          function apply(lens) {
            buttons.forEach(function (b) {
              var on = b.dataset.lens === lens;
              b.classList.toggle('active', on);
              b.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            sub.textContent = LENSES[lens].sub;
            rows.sort(function (a, b) {
              var ah = a.dataset[lens] === '1' ? 0 : 1;
              var bh = b.dataset[lens] === '1' ? 0 : 1;
              if (ah !== bh) return ah - bh;
              return (+a.dataset.open) - (+b.dataset.open);
            });
            rows.forEach(function (r) {
              r.classList.toggle('sc-hit', r.dataset[lens] === '1');
              r.querySelector('.sc-note').textContent = r.getAttribute('data-' + lens + '-note') || '';
              tbody.appendChild(r);
            });
          }
          buttons.forEach(function (b) {
            b.addEventListener('click', function () { apply(b.dataset.lens); });
          });
          apply({{ b.lenses[0].key | tojson }});
        })();
        </script>
{%- endmacro %}

{#- dispatcher: render any block by its declared type -#}
{%- macro render(b) -%}
{%- if   b.type == 'lede'       %}{{ lede(b) }}
{%- elif b.type == 'quote'      %}{{ quote(b) }}
{%- elif b.type == 'stats'      %}{{ stats(b) }}
{%- elif b.type == 'h3'         %}{{ h3(b) }}
{%- elif b.type == 'prose'      %}{{ prose(b) }}
{%- elif b.type == 'note'       %}{{ note(b) }}
{%- elif b.type == 'verify'     %}{{ verify(b) }}
{%- elif b.type == 'table'      %}{{ table(b) }}
{%- elif b.type == 'callout'    %}{{ callout(b) }}
{%- elif b.type == 'finding'    %}{{ finding(b) }}
{%- elif b.type == 'chips'      %}{{ chips(b) }}
{%- elif b.type == 'relations'  %}{{ relations(b) }}
{%- elif b.type == 'lattice'    %}{{ lattice(b) }}
{%- elif b.type == 'engines'    %}{{ engines(b) }}
{%- elif b.type == 'scorecards' %}{{ scorecards(b) }}
{%- else %}{{ raise_unknown(b.type) }}
{%- endif -%}
{%- endmacro -%}
