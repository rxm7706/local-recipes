#!/usr/bin/env python3
"""
Switch the active BMad project for this repository.

The "active project" determines which `_bmad-output/projects/<slug>/` overlay
the BMAD config resolver loads (layers 5–6). This script writes the slug to
`_bmad/custom/.active-project` (gitignored marker file). Other resolution
mechanisms (--project flag on resolve_config.py, BMAD_ACTIVE_PROJECT env var)
take precedence over the marker file.

Switching also re-points the two gitignored compatibility symlinks:

    _bmad-output/planning-artifacts       -> projects/<slug>/planning-artifacts
    _bmad-output/implementation-artifacts -> projects/<slug>/implementation-artifacts

These are load-bearing: `_bmad/bmm/config.yaml` hard-codes
`planning_artifacts: "{project-root}/_bmad-output/planning-artifacts"`, which does
NOT compose with a project's `output_folder` override — so every BMAD skill that
writes planning artifacts resolves THROUGH these symlinks. Before 2026-07-14 this
script wrote only the marker and left the symlinks wherever they last pointed, so
`bmad-switch <other> && <run a BMAD write-skill>` silently wrote into the PREVIOUS
project's artifacts. (Observed: a 10h desync — symlinks on pyforge-warden while the
marker said local-recipes — which would have clobbered pyforge-warden's PRD/epics
during a local-recipes re-sync.) The marker is written LAST, so a failed re-point
aborts before the marker can disagree with the links.

Usage:
    bmad-switch <slug>          # set active project (marker + symlinks)
    bmad-switch --list          # list known projects under _bmad-output/projects/
    bmad-switch --current       # print the active project (hard-fails on marker/symlink drift)
    bmad-switch --clear         # remove the marker (no active project)

The slug must be lowercase alphanumeric + hyphens/underscores. The corresponding
project directory `_bmad-output/projects/<slug>/` must exist.
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path


def _load_verify_scope(root: Path):
    """Import the sole Story 20.6 primitive (never a local reimplementation)."""
    try:
        from pyforge.marshal.scope import ScopeDrift, verify_scope
        return verify_scope, ScopeDrift
    except ImportError:
        # The primitive lives in THIS repo's marshal source tree. `root` may be a
        # fixture tree (the Story 20.7 tests point it at tmp_path), so fall back
        # to the checkout this script sits in before giving up.
        here = Path(__file__).resolve().parent.parent
        for base in (root, here):
            src = base / "src" / "shared" / "packages" / "pyforge-marshal" / "src"
            if src.is_dir():
                if str(src) not in sys.path:
                    sys.path.insert(0, str(src))
                break
        from pyforge.marshal.scope import ScopeDrift, verify_scope
        return verify_scope, ScopeDrift


def format_scope_drift(drift) -> str:
    """Human-readable ScopeDrift for stderr (names found-vs-expected)."""
    return (
        "scope drift: "
        f"expected {drift.expected!r} but "
        f"marker={drift.marker!r}, "
        f"planning-artifacts={drift.planning_artifacts!r}, "
        f"implementation-artifacts={drift.implementation_artifacts!r}"
    )


_SLUG_PATTERN = re.compile(r"^[a-z0-9][a-z0-9_-]*$")

# Gitignored compatibility symlinks under _bmad-output/ that must track the
# active project. Order matters only for deterministic error reporting.
_ARTIFACT_LINKS = ("planning-artifacts", "implementation-artifacts")


def repo_root() -> Path:
    """Walk up from this script's location until we find _bmad/ + _bmad-output/."""
    here = Path(__file__).resolve()
    for candidate in (here, *here.parents):
        if (candidate / "_bmad").is_dir() and (candidate / "_bmad-output").is_dir():
            return candidate
    sys.stderr.write(
        f"error: could not locate repo root (no ancestor with _bmad/ and _bmad-output/) from {here}\n"
    )
    sys.exit(1)


def main_checkout_root(root: Path) -> Path | None:
    """The main checkout's root when `root` is a linked git worktree, else None.

    In a linked worktree `.git` is a file (a `gitdir:` pointer), not a
    directory; the common dir resolves to `<main-checkout>/.git`.
    """
    if not (root / ".git").is_file():
        return None
    common = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    return Path(common).parent


def ensure_tier3_backlink(root: Path, slug: str, main_root: Path) -> int:
    """Point a worktree's gitignored Tier-3 dir at the main checkout's canonical one.

    `projects/<slug>/implementation-artifacts` is gitignored, so a linked
    worktree starts without it — and a per-worktree copy would fork the
    sprint feed / journals. A symlink back to the main checkout keeps ONE
    canonical Tier-3 store at the same repo-relative path everywhere.
    Refuses to replace a real non-empty directory (that would orphan state).
    """
    local = root / "_bmad-output" / "projects" / slug / "implementation-artifacts"
    canonical = main_root / "_bmad-output" / "projects" / slug / "implementation-artifacts"
    canonical.mkdir(parents=True, exist_ok=True)
    if local.is_symlink():
        if local.resolve() == canonical.resolve():
            return 0
        local.unlink()
    elif local.is_dir():
        if any(local.iterdir()):
            sys.stderr.write(
                f"error: {local} is a real non-empty directory — refusing to replace it "
                f"with a backlink to {canonical}.\nMerge its contents into the main "
                f"checkout's copy manually, then re-run.\n"
            )
            return 7
        local.rmdir()
    local.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(canonical, local)
    print(f"tier-3 backlink: {local.relative_to(root)} -> {canonical}")
    return 0


def marker_path(root: Path) -> Path:
    return root / "_bmad" / "custom" / ".active-project"


def link_path(root: Path, name: str) -> Path:
    return root / "_bmad-output" / name


def repoint_links(root: Path, slug: str) -> int:
    """Atomically re-point the artifact symlinks at `slug`.

    Refuses to touch a path that exists and is not a symlink — that would mean
    destroying real artifacts rather than moving a pointer.
    """
    for name in _ARTIFACT_LINKS:
        path = link_path(root, name)
        if path.exists() and not path.is_symlink():
            sys.stderr.write(
                f"error: {path} is a real directory, not a symlink — refusing to replace it.\n"
                f"Move it aside manually if it should be a symlink to projects/{slug}/{name}.\n"
            )
            return 4
        target_dir = root / "_bmad-output" / "projects" / slug / name
        if not target_dir.is_dir():
            sys.stderr.write(f"error: symlink target does not exist: {target_dir}\n")
            return 5

    for name in _ARTIFACT_LINKS:
        path = link_path(root, name)
        target = Path("projects") / slug / name  # relative to _bmad-output/
        tmp = path.with_name(f".{name}.tmp-{os.getpid()}")
        try:
            if tmp.is_symlink() or tmp.exists():
                tmp.unlink()
            os.symlink(target, tmp)
            os.replace(tmp, path)  # atomic; replaces the old symlink in place
        except OSError as error:
            if tmp.is_symlink():
                tmp.unlink(missing_ok=True)
            sys.stderr.write(f"error: failed to re-point {path} -> {target}: {error}\n")
            return 6
        print(f"symlink: _bmad-output/{name} -> {target}")
    return 0


def list_projects(root: Path) -> list[str]:
    projects_dir = root / "_bmad-output" / "projects"
    if not projects_dir.is_dir():
        return []
    return sorted(p.name for p in projects_dir.iterdir() if p.is_dir())


def cmd_list(root: Path) -> int:
    projects = list_projects(root)
    if not projects:
        sys.stderr.write(f"no projects found under {root / '_bmad-output' / 'projects'}/\n")
        return 1
    current = read_marker(root)
    for slug in projects:
        marker = "*" if slug == current else " "
        print(f"  {marker} {slug}")
    if current:
        print(f"\nactive: {current}")
    else:
        print("\nactive: (none)")
    if current:
        verify_scope, _ScopeDrift = _load_verify_scope(root)
        drift = verify_scope(root, current)
        if drift is not None:
            sys.stderr.write(f"\nerror: {format_scope_drift(drift)}\n")
            return 2
    return 0


def read_marker(root: Path) -> str | None:
    path = marker_path(root)
    if not path.exists():
        return None
    try:
        value = path.read_text(encoding="utf-8").strip()
        return value or None
    except OSError as error:
        sys.stderr.write(f"warning: failed to read {path}: {error}\n")
        return None


def cmd_current(root: Path) -> int:
    current = read_marker(root)
    if not current:
        sys.stderr.write("no active project (marker file empty or missing)\n")
        return 1
    verify_scope, _ScopeDrift = _load_verify_scope(root)
    drift = verify_scope(root, current)
    if drift is not None:
        # Print claimed marker then hard-fail naming the drift (CAP-3).
        print(current)
        sys.stderr.write(f"error: {format_scope_drift(drift)}\n")
        return 2
    print(current)
    return 0


def cmd_clear(root: Path) -> int:
    path = marker_path(root)
    if path.exists():
        path.unlink()
        print(f"cleared active project (removed {path})")
    else:
        print("no active project to clear")
    return 0


def cmd_switch(root: Path, slug: str) -> int:
    if not _SLUG_PATTERN.match(slug):
        sys.stderr.write(
            f"error: invalid slug {slug!r} "
            f"(expected lowercase alphanumeric + hyphens/underscores)\n"
        )
        return 2
    project_dir = root / "_bmad-output" / "projects" / slug
    if not project_dir.is_dir():
        sys.stderr.write(
            f"error: project directory does not exist: {project_dir}\n"
            f"create it (and its .bmad-config.toml) before switching, "
            f"or run with --list to see known projects.\n"
        )
        return 3
    # Inside a linked worktree, provision the gitignored Tier-3 dir as a
    # backlink to the main checkout's canonical store before the symlink
    # check would fail on it.
    main_root = main_checkout_root(root)
    if main_root is not None:
        status = ensure_tier3_backlink(root, slug, main_root)
        if status:
            sys.stderr.write("aborted: marker and symlinks left unchanged.\n")
            return status
    # Re-point the symlinks FIRST: they are the failure-prone half, and the
    # marker must never advance past them (that desync is the bug this guards).
    status = repoint_links(root, slug)
    if status:
        sys.stderr.write("aborted: marker left unchanged so it cannot disagree with the symlinks.\n")
        return status

    path = marker_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(slug + "\n", encoding="utf-8")
    print(f"active project: {slug}")
    print(f"marker: {path}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Switch active BMad project (writes _bmad/custom/.active-project marker).",
    )
    parser.add_argument("slug", nargs="?", help="Project slug to activate")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--list", action="store_true", help="List known projects")
    group.add_argument("--current", action="store_true", help="Print active project")
    group.add_argument("--clear", action="store_true", help="Remove active marker")
    args = parser.parse_args()

    root = repo_root()

    if args.list:
        return cmd_list(root)
    if args.current:
        return cmd_current(root)
    if args.clear:
        return cmd_clear(root)
    if not args.slug:
        parser.print_help(sys.stderr)
        return 1
    return cmd_switch(root, args.slug)


if __name__ == "__main__":
    sys.exit(main())
