---
/**
 * One card of the gallery, the decks index or a family page (Story 43.2): a link to the reader's
 * page and a preview of the twin the build copied, the iframe marked lazy so a 100 KB - 6 MB page
 * loads only near the viewport (the Jinja shell mounts the same frame from a script).
 */
interface Props {
  href: string;
  /** The twin to preview, relative to this page. */
  preview: string;
  placeholder: string;
}

const { href, preview, placeholder } = Astro.props;
---

<a class="shot" href={href}>
  <div class="shot-frame">
    <span class="shot-placeholder" aria-hidden="true">{placeholder}</span>
    <iframe
      src={preview}
      loading="lazy"
      title=""
      aria-hidden="true"
      tabindex="-1"
      scrolling="no"
      onload="this.parentElement.classList.add('is-loaded')"></iframe>
  </div>
  <div class="shot-meta">
    <slot />
  </div>
</a>
