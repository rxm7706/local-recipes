---
/**
 * Story 43.5 (CAP-61): Starlight's footer, then the line saying what built the page (`src/lib/built-from.ts`), the
 * same element every herald page carries. Registered in astro.config.mjs only with pyforge.herald.pages_one_generator
 * on, so with the flag off the docs keep Starlight's own footer.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import { builtFromHtml } from '../lib/built-from';
---

<Default />
<Fragment set:html={builtFromHtml()} />
