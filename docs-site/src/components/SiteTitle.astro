---
/**
 * Story 40.1 (spec-pyforge-herald CAP-58): the site title plus the top menu shared by the docs
 * and herald pages. Since Story 43.7 the menu is the registry's (`docs/map.yaml` `sections`, read by
 * src/lib/site-nav.ts), as site-root paths; every href is prefixed with the base path of the host
 * that builds the artifact (CAP-56), never a hardcoded one.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { siteNav } from '../lib/site-nav';

const topnav = siteNav().menu;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div class="pf-title-and-menu sl-flex">
  <Default />
  <nav class="pf-top-menu" aria-label="Site">
    <ul>
      {
        topnav.map((item) => (
          <li>
            <a data-pf-menu-link href={`${base}${item.path}`}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .pf-title-and-menu {
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  .pf-top-menu {
    display: none;
  }
  .pf-top-menu ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-top-menu a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .pf-top-menu a:hover {
    color: var(--sl-color-white);
  }
  /* On narrow screens the sidebar's section groups carry the same links. */
  @media (min-width: 72rem) {
    .pf-top-menu {
      display: block;
    }
  }
</style>
