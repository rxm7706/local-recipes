---
/**
 * The shared menu is herald's one navigation list (docsite/content/site.yml), read through the
 * generated top-menu JSON exactly as SiteTitle.astro reads it (Story 40.1, CAP-58) -- so an entry
 * that needs the Kedro-Viz mount drops out here too when no export is mounted (Story 42.2, CAP-60). The page
 * carries the herald Content-Security-Policy (Story 43.3, AD-21), and its faces, tokens and rules come from the one
 * herald stylesheet, bundled by Astro, with the theme the docs header's toggle chose (Story 43.4).
 */
import { HERALD_CSP, THEME_SCRIPT } from '../lib/herald-pages';
import '../styles/herald.css';
import topnav from '../topnav.generated.json';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
/** Same rel prefix as docsite/templates/shell_page.html.j2 for the dossier page. */
const rel = '../';
/** This page is /herald/dossier/; menu paths are relative to the site root. */
const toRoot = `${rel}../`;
const current = 'herald/dossier/';
const nav = topnav.map((item) => ({ label: item.label, href: `${toRoot}${item.path}`, path: item.path }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content="Astro" />
    <meta http-equiv="Content-Security-Policy" content={HERALD_CSP} />
    <script is:inline set:html={THEME_SCRIPT} />
  </head>
  <body>
    <header class="site-nav">
      <div class="site-nav-inner">
        <a class="site-brand" href={`${rel}index.html`}><span class="spark"></span>PyForge</a>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  class="nav-link"
                  data-pf-menu-link
                  href={item.href}
                  aria-current={item.path === current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <span class="nav-spacer"></span>
      </div>
    </header>
    <slot />
  </body>
</html>
