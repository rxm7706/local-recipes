---
/**
 * /herald/infographics/ -- the gallery (Story 43.2, CAP-61): site.yml's include list resolved in its
 * order, each infographic with its title and a lazy preview of its twin, linking the reader's page
 * (the wrapper that carries the back-bar, ./[page].html.ts). A rest route so that with
 * pyforge.herald.pages_one_generator off it emits no file and the Jinja gallery is the only one.
 */
import Shot from '../../../components/herald/Shot.astro';
import HeraldLayout from '../../../layouts/HeraldLayout.astro';
import { loadHeraldPages, pagesOneGenerator } from '../../../loaders/herald-pages-loader';

export function getStaticPaths() {
  return pagesOneGenerator() ? [{ params: { index: undefined } }] : [];
}

const pages = loadHeraldPages();
const site = pages.site;
const items = pages.infographics;
const globs = site.infographics.include.length;
---

<HeraldLayout
  title={`Infographics — ${site.name}`}
  description={`${items.length} standalone infographics published from the repository.`}
  rel="../"
  current="herald/infographics/"
  favicon={site.favicon}
  shortName={site.short_name ?? site.name}
  builtAt={pages.builtAt}
  commit={pages.commit}
>
  <div class="page">
    <div class="lander">
      <div class="kicker"><span class="dot"></span>Standalone visuals</div>
      <h1>Infographics</h1>
      <p class="blurb">
        Each of these is a self-contained page, authored separately and published here as committed: only its font
        links point at the site's own fonts. They are rebuilt straight from the files in the repository, so whatever is
        committed is what appears.
      </p>
    </div>

    {
      items.length ? (
        <div class="gallery">
          {items.map((ig) => (
            <Shot href={ig.outName} preview={`../${ig.twin}`} placeholder={ig.title}>
              <h3>{ig.title}</h3>
              {ig.description ? <p>{ig.description}</p> : null}
              <span class="shot-file">{ig.source}</span>
            </Shot>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3>No infographics found yet</h3>
          <p>
            The build resolved {globs} glob{globs === 1 ? '' : 's'} and matched no <code>.html</code> files, so the
            gallery is empty rather than broken.
          </p>
        </div>
      )
    }

    <footer>
      <span>
        Published from the repository &mdash; each page frames its file under a thin back-link bar; the file is copied
        with only its font links pointed at the site's own fonts.
      </span>
      <span>Site rebuilt {pages.builtAt}</span>
    </footer>
  </div>
</HeraldLayout>
