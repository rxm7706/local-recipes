---
import { getEntry } from 'astro:content';

import DossierBody from '../../../components/dossier/DossierBody.astro';
import HeraldDossierLayout from '../../../layouts/HeraldDossierLayout.astro';

const entry = await getEntry('dossier', 'dossier');
if (!entry) {
  throw new Error('the dossier collection entry is missing (docs-site/src/content/dossier/dossier.yml)');
}
const doc = entry.data as Record<string, unknown>;
---

<HeraldDossierLayout title={doc.title as string} description={doc.summary as string}>
  <DossierBody doc={doc} />
</HeraldDossierLayout>
