{
  "realm": "platform",
  "displayName": "Platform (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "groups": [
    {
      "name": "platform-staff",
      "path": "/platform-staff"
    },
    {
      "name": "platform-superuser",
      "path": "/platform-superuser"
    },
    {
      "name": "pyforge:station:marshal",
      "path": "/pyforge:station:marshal"
    }
  ],
  "clients": [
    {
      "clientId": "platform-web",
      "name": "Platform web (confidential)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-compose-keycloak-secret-not-real",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "platform-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "staff-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Staff",
      "lastName": "User",
      "email": "staff-user@localhost.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "staff-user",
          "temporary": false
        }
      ],
      "groups": ["/platform-staff"]
    }
  ]
}
