# build artifacts
# dist/       -> pypi: wheel + sdist (python -m build)
# dist-conda/ -> conda: .conda (pixi build --output-dir dist-conda)
# (comments on their own lines: gitignore has no trailing-comment syntax --
# an inline `#` becomes part of the pattern and the ignore matches nothing)
/dist/
/dist-conda/
/build/
*.conda
*.whl
*.tar.gz
*.egg-info/
__pycache__/
.pytest_cache/
