{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-recipes:pyforge-steward:ci-status-schema",
  "title": "CiStatusReport",
  "description": "Frozen envelope for steward ci status --json (Story 99.3 / CAP-166 FR-39). Additive changes only.",
  "type": "object",
  "required": ["fetched_at", "repo", "rate_limit", "rows"],
  "properties": {
    "fetched_at": {
      "type": "string",
      "description": "ISO-8601 timestamp when GitHub data was collected."
    },
    "repo": {
      "type": "string",
      "description": "owner/name repository slug."
    },
    "rate_limit": {
      "type": "object",
      "required": ["core_limit", "core_remaining"],
      "properties": {
        "core_limit": { "type": "integer" },
        "core_remaining": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "partial": {
      "type": "boolean",
      "description": "Present, and true, only on a partial read: one or more surfaces' run lists could not be read, and those rows read last_green_run \"unknown\". Absent on a complete read. The exit code is 1 (Story 103.7)."
    },
    "run_list_errors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "One \"<workflow>: <gh error>\" entry per run list that could not be read; present only with partial (Story 103.7)."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "id",
        "switch",
        "declared_state",
        "live_switch_value",
        "verdict"
      ],
      "properties": {
        "id": { "type": "string" },
        "switch": { "type": ["string", "null"] },
        "declared_state": { "type": "string" },
        "live_switch_value": { "type": ["string", "null"] },
        "paused_since": { "type": ["string", "null"] },
        "review_by": { "type": ["string", "null"] },
        "review_days_left": { "type": ["integer", "null"] },
        "owner": { "type": ["string", "null"] },
        "trigger": {
          "description": "`main` when the surface never runs on a pull_request (push-to-main and the nightly canary; Story 117.6, CAP-175 ruling D1); null when it follows its workflow's triggers.",
          "type": ["string", "null"],
          "enum": ["main", null]
        },
        "last_green_run": { "type": ["string", "null"] },
        "latest_main_run": {
          "description": "The newest completed run of the row's workflow on main that a PR did not start, from the listed runs; null when none qualifies or the row is retired (Story 99.8). Optional: rows built before it, and the master and unregistered rows, carry none.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["conclusion", "created_at", "run_id"],
              "properties": {
                "conclusion": { "type": "string" },
                "created_at": { "type": ["string", "null"] },
                "run_id": { "type": ["integer", "null"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "verdict": {
          "enum": [
            "live",
            "paused",
            "opt-in-off",
            "paused-manually",
            "retired",
            "drift",
            "stuck",
            "overdue"
          ]
        },
        "detail": { "type": "string" },
        "paused_by_master": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
